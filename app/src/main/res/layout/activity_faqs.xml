            <TextView android:textSize="12.0sp" android:textColor="@color/md_black" android:gravity="center" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginLeft="20.0dip" android:layout_marginRight="20.0dip" android:layout_marginBottom="10.0dip" android:layout_marginTop="5dip" android:text="@string/developer" android:alpha="0.9" />

