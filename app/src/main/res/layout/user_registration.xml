<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:fitsSystemWindows="true">

        <!-- Decorative top circle -->
        <View
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_marginTop="-105dp"
            android:layout_marginEnd="-65dp"
            android:background="@drawable/circle_green_light"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Yellow accent -->
        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="90dp"
            android:background="@drawable/yellow_dot"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="232dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/moreSet"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp">

                    <!-- Logo -->
                    <ImageView
                        android:id="@+id/logo"
                        android:layout_width="190dp"
                        android:layout_height="70dp"
                        android:layout_marginTop="42dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="Nextel Connect"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_logo"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Green circle -->
                    <View
                        android:id="@+id/backCircle"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginStart="-10dp"
                        android:background="@drawable/circle_green_light"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/logo" />

                    <!-- Back button -->
                    <TextView
                        android:id="@+id/backButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp"
                        android:text="‹  Back"
                        android:textColor="@color/colorWhite"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/logo" />

                    <!-- Register title -->
                    <TextView
                        android:id="@+id/registerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Create Account"
                        android:textColor="@color/dark_green"
                        android:textSize="31sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@id/registerSubtitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- Register subtitle -->
                    <TextView
                        android:id="@+id/registerSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:layout_marginBottom="18dp"
                        android:text="Join Nextel Connect and get started today"
                        android:textColor="#858585"
                        android:textSize="15sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/registerCenter"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/registerScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="28dp"
                        android:paddingEnd="28dp"
                        android:paddingBottom="40dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:text="Full name"
                            android:textColor="@color/text_black"
                            android:textSize="15sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/nameLayout"
                            style="@style/NextelTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="2dp"
                            app:startIconDrawable="@drawable/user_icon">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/nameInput"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:hint="Your name"
                                android:inputType="text"
                                android:maxLines="1"
                                android:textSize="15sp" />

                        </com.google.android.material.textfield.TextInputLayout>


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:text="Email"
                            android:textColor="@color/text_black"
                            android:textSize="15sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/emailLayout"
                            style="@style/NextelTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="2dp"
                            app:startIconDrawable="@android:drawable/sym_action_email">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/emailInput"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:hint="Enter your email address"
                                android:inputType="textEmailAddress"
                                android:maxLines="1"
                                android:textSize="15sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:text="Username"
                            android:textColor="@color/text_black"
                            android:textSize="15sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/usernameLayout"
                            style="@style/NextelTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="2dp"
                            app:startIconDrawable="@drawable/ic_email">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/usernameInput"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:hint="Choose preferred username"
                                android:inputType="text"
                                android:maxLines="1"
                                android:textSize="15sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:text="Country"
                            android:textColor="@color/text_black"
                            android:textSize="15sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/countryLayout"
                            style="@style/NextelTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="2dp"
                            app:endIconMode="dropdown_menu"
                            app:startIconDrawable="@drawable/ic_globe">

                            <AutoCompleteTextView
                                android:id="@+id/countryInput"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:clickable="true"
                                android:focusable="false"
                                android:hint="Select country"
                                android:inputType="none"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:textSize="15sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:text="Phone number"
                            android:textColor="@color/text_black"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/phone_input_background"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/countryDialCode"
                                android:layout_width="65dp"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="+234"
                                android:textColor="@color/dark_green"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="1dp"
                                android:layout_height="30dp"
                                android:background="#D0D0D0" />

                            <EditText
                                android:id="@+id/phoneInput"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:hint="Phone number"
                                android:inputType="phone"
                                android:maxLines="1"
                                android:paddingStart="14dp"
                                android:paddingEnd="12dp"
                                android:textSize="15sp"
                                android:drawableEnd="@drawable/ic_call" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            android:text="Promo code"
                            android:textColor="@color/text_black"
                            android:textSize="15sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/promoLayout"
                            style="@style/NextelTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="8dp"
                            app:startIconDrawable="@drawable/ic_coupon">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/promoInput"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:hint="Referral username (optional)"
                                android:inputType="text"
                                android:maxLines="1"
                                android:textSize="15sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Password"
                            android:textColor="@color/text_black"
                            android:textSize="15sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/passwordLayout"
                            style="@style/NextelTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="8dp"
                            app:endIconMode="password_toggle"
                            app:startIconDrawable="@drawable/lock_outline">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/passwordInput"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:hint="Create password"
                                android:inputType="textPassword"
                                android:maxLines="1"
                                android:textSize="15sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <CheckBox
                                android:id="@+id/termsCheckbox"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="-8dp"
                                android:buttonTint="@color/dark_green" />

                            <TextView
                                android:id="@+id/termsText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:lineSpacingExtra="2dp"
                                android:textColor="#777777"
                                android:text="I agree to the Terms &amp; Conditions and Privacy Policy."
                                android:textSize="13sp"
                                android:linksClickable="true" />

                        </LinearLayout>

                    <LinearLayout
                        style="?android:attr/buttonBarStyle"
                        android:id="@+id/registerLayout"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="15dp">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="60dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/registerButton"
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:text="Create Account"
                                android:textAllCaps="false"
                                android:textColor="@android:color/white"
                                android:textSize="17sp"
                                app:backgroundTint="@color/dark_green"
                                app:cornerRadius="30dp"
                                app:elevation="0dp" />

                            <ProgressBar
                                android:id="@+id/progress"
                                android:background="@drawable/bg_button"
                                android:visibility="gone"
                                android:layout_marginRight="10dp"
                                android:layout_height="match_parent"
                                android:layout_width="match_parent"/>

                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Already have an account?"
                            android:textColor="#909090"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/loginButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="5dp"
                            android:text="Login"
                            android:textColor="@color/dark_green"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    </LinearLayout>

                </androidx.core.widget.NestedScrollView>

            </LinearLayout>

            <!-- Footer -->
            <LinearLayout
                android:id="@+id/registerFooter"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/validateCode"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1.0"
                    android:background="#000"
                    android:layout_marginLeft="5dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="Validate"
                    android:textColor="#fff" />

            </LinearLayout>

        </LinearLayout>

        <!-- Decorative bottom circle -->
        <View
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginStart="-160dp"
            android:layout_marginBottom="-135dp"
            android:background="@drawable/circle_green_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>