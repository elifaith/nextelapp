<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:layout_width="180dp"
        android:layout_height="68dp"
        android:adjustViewBounds="true"
        android:contentDescription="Nextel Connect"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_logo" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:gravity="center"
        android:text="Account suspended"
        android:textColor="@color/dark_green"
        android:textSize="29sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/suspendedMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="This account has been suspended. Please contact support."
        android:textColor="#707070"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/contactSupportButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="30dp"
        android:text="Contact support"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:backgroundTint="@color/dark_green"
        app:cornerRadius="28dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/returnToLoginButton"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="Return to login"
        android:textAllCaps="false"
        android:textColor="@color/dark_green" />
</LinearLayout>
