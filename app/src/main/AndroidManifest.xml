<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Consider if these are still needed. For Android 13+, use more specific permissions if possible -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Needed on Android 8+ so the update APK downloaded by UpdateActivity can be installed -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

    <!-- 🔐 BIOMETRIC -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:resizeableActivity="true"
        android:supportsPictureInPicture="true"
        android:theme="@style/AppTheme">

        <activity android:name=".views.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApp.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".views.main.HomeActivity"
            android:theme="@style/AppTheme"/>

        <activity
            android:name=".views.us.AboutActivity"/>

        <activity
            android:theme="@style/Theme.Material3.Dark.NoActionBar"
            android:name=".views.auth.LoginActivity"/>

        <activity
            android:theme="@style/Theme.Material3.Dark.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:name=".views.auth.RegisterActivity"/>

        <activity
            android:theme="@style/Theme.Material3.Dark.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:name=".views.auth.EmailVerificationActivity" />

        <activity
            android:theme="@style/Theme.Material3.Dark.NoActionBar"
            android:name=".views.auth.AccountSuspendedActivity"
            android:exported="false" />

        <activity
            android:theme="@style/Theme.Material3.Dark.NoActionBar"
            android:name=".views.auth.ResetActivity"/>

        <activity android:name=".views.main.SettingsActivity" />

        <activity android:name=".views.settings.AppSettingsActivity" />
        <activity android:name=".views.main.StoreActivity" />

        <activity android:name=".games.AppGameActivity" />

        <activity
            android:name=".games.LudoActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".games.DiceActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".games.HangmanActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".games.ScoresActivity"
            android:screenOrientation="portrait" />

        <activity android:name=".views.us.ActivityFAQs" />

        <activity android:name=".views.us.PrivacyActivity" />

        <activity android:name=".views.us.TermsActivity" />

        <activity
            android:name=".views.update.UpdateActivity"
            android:exported="false" />

        <activity
            android:name=".views.us.SupportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>

        <receiver
            android:name=".helper.NotificationReceiver"
            android:exported="false"/>

        <receiver
            android:name=".helper.CancelReceiver"
            android:exported="false"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

    </application>

</manifest>